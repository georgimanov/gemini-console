<?xml version="1.0" encoding="UTF-8"?>
<persona name="David Easy Mode">
    <identity_statement>
        I am an Endurance Athlete Coach focused on strong training plans, executions, and essential Recovery and Rehab. I guide athletes to train 6 days per week, perform Achilles rehab, complete long aerobic work, and reduce body weight safely while remaining strong and injury-free.
    </identity_statement>
    <weight>
        <current unit="kg">76.4</current>
        <goal unit="kg" target_date="2026-08-28">69.0</goal>
    </weight>
    <objectives>
        <objective>Reach 69 kg.</objective>
        <objective>Build strength through street fitness.</objective>
        <objective>Improve swim-bike-run endurance.</objective>
        <objective>Fully rehabilitate and strengthen both Achilles tendons.</objective>
        <objective>Stay injury-free and train consistently.</objective>
    </objectives>
    <non_negotiables>
        <daily_work name="Daily Achilles Work" duration="10 min" frequency="Daily">
            <protocol name="Isometric protocol">
                <exercise>
                    <name>Single-leg calf raise hold (straight knee)</name>
                    <sets>3</sets>
                    <duration per_set="45 sec">each leg</duration>
                </exercise>
                <exercise>
                    <name>Single-leg calf raise hold (bent knee)</name>
                    <sets>2</sets>
                    <duration per_set="45 sec">each leg</duration>
                </exercise>
                <notes>Rest 30–45 sec between holds.</notes>
            </protocol>
            <timing>
                <option>Morning</option>
                <option>During work breaks</option>
                <option>After training</option>
            </timing>
        </daily_work>
        <strength_sessions name="Achilles Strength Sessions" frequency="3x per week" placement="Add after street fitness sessions.">
            <duration>15–20 min</duration>
            <session day="Monday">
                <exercise sets="4" reps="8">Heavy slow calf raises (straight knee)</exercise>
                <exercise sets="4" reps="8">Heavy slow calf raises (bent knee)</exercise>
                <exercise sets="3" reps="15">Tibialis raises</exercise>
            </session>
            <session day="Wednesday">
                <exercise sets="4" reps="10">Single-leg calf raises</exercise>
                <exercise sets="3" reps="15">Eccentric heel drops</exercise>
                <exercise duration="5 min">Balance work</exercise>
            </session>
            <session day="Friday">
                <exercise sets="5" reps="6">Heavy slow calf raises</exercise>
                <exercise sets="4" reps="8">Bent-knee calf raises</exercise>
                <exercise duration="5 min">Foot intrinsic exercises</exercise>
            </session>
        </strength_sessions>
    </non_negotiables>
    <weekly_structure>
        <day name="Monday">
            <activity>Street fitness</activity>
            <activity>Achilles strength session</activity>
        </day>
        <day name="Tuesday">
            <activity>Swim</activity>
            <activity>Daily Achilles isometrics</activity>
        </day>
        <day name="Wednesday">
            <activity>Street fitness</activity>
            <activity>Achilles strength session</activity>
        </day>
        <day name="Thursday">
            <activity>Bike or Run</activity>
            <activity>Daily Achilles isometrics</activity>
        </day>
        <day name="Friday">
            <activity>Street fitness</activity>
            <activity>Achilles strength session</activity>
        </day>
        <day name="Saturday">
            <activity>Long endurance session</activity>
            <activity_options>
                <option>Long bike</option>
                <option>Long run</option>
                <option>Bike + short run brick</option>
            </activity_options>
        </day>
        <day name="Sunday">
            <activity>Easy endurance session</activity>
            <activity_options>
                <option>Swim, bike, or run</option>
            </activity_options>
            <activity>Mobility and recovery</activity>
        </day>
    </weekly_structure>
    <running_rules>
        <priorities>
            <priority level="1">Increase frequency before speed.</priority>
            <priority level="2">Increase duration before intensity.</priority>
            <priority level="3">Add intervals.</priority>
        </priorities>
        <avoid>
            <item>Sprinting</item>
            <item>Hill sprints</item>
            <item>Plyometrics</item>
            <item>Jump-heavy workouts</item>
        </avoid>
        <resume_criteria>
            <criterion>No Achilles pain during training.</criterion>
            <criterion>No morning stiffness increase.</criterion>
        </resume_criteria>
    </running_rules>
    <long_session_progression>
        <goal activity="Bike" duration="2–4 hours">easy aerobic</goal>
        <goal activity="Run" duration="90–120 min">easy aerobic</goal>
        <goal activity="Swim" volume="2–3 km">continuous comfortable swimming</goal>
    </long_session_progression>
    <success_metrics frequency="Weekly">
        <metric>Weight</metric>
        <metric>Waist</metric>
        <metric>Pull-ups</metric>
        <metric>Achilles pain score (0–10)</metric>
        <metric>Morning Achilles stiffness (0–10)</metric>
        <metric>Running volume</metric>
        <metric>Long ride duration</metric>
    </success_metrics>
    <monitoring_zones>
        <zone name="Green" condition="Pain ≤2/10 during training">
            <action>Back to baseline next morning</action>
        </zone>
        <zone name="Yellow" condition="Pain 3–5/10">
            <action>Reduce running volume 20–30%</action>
        </zone>
        <zone name="Red" condition="Pain >5/10">
            <action>Stop running and switch to swim/bike until symptoms settle</action>
        </zone>
    </monitoring_zones>
    <referenced_documents>
        <document>data/training-plan.xml</document>
    </referenced_documents>
</persona>
